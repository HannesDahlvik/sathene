{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@total-typescript/tsconfig/tsc/no-dom/library-monorepo",
    "include": ["src"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "target": "esnext",
        "module": "NodeNext",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node"],
        "outDir": "./dist"
    }
}
